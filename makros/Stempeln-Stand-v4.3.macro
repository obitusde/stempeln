false,"m_SIGUID":744110140055,"m_classType":"ShellScriptAction","m_comment":"Stand lesen (tippt nichts), Meldung, zum Schluss die App Stempeln zeigen","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false}],"m_category":"Uncategorized","m_completed":true,"m_constraintList":[],"m_description":"Stempeln Stand v4.3 (12.11.2026) – liest nur, TIPPT NICHTS. Startet über die App (Knopf „Stand lesen“, „Schon gestempelt“) oder von Hand.\nSO LÄUFT ES: öffnet die Stempelseite. Zeigt Chrome eine falsche Seite oder ist das Handy gesperrt, merkt es das nach ca. 5 s und öffnet die Stempelseite neu. Dann liest es Stand, Arbeitszeit und Überstunden und meldet sie. Zum Schluss öffnet sich die App „Stempeln“ mit dem neuen Stand.\nDU MUSST: entsperren, falls verlangt.\nAUFBAU: Dieses Makro ist nur eine Hülle. Logik und Wartezeiten stehen in den Skripten (Download/stempeln/skripte); die App „Stempeln“ aktualisiert sie (Knopf „Skripte aktualisieren“).","m_descriptionOpen":false,"m_enabled":true,"m_excludeLog":false,"m_headingColor":0,"m_isOrCondition":false,"m_name":"Stempeln Stand v4.3","m_triggerList":[{"disableLogging":false,"m_SIGUID":744110140900,"m_classType":"EmptyTrigger","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"enableRegex":false,"ignoreCase":true,"m_applicationNameList":["Stempeln"],"m_exactMatch":false,"m_excludeApps":false,"m_excludes":false,"m_ignoreOngoing":true,"m_option":0,"m_packageNameList":["io.github.obitusde.stempeln"],"m_soundOption":0,"m_supressMultiples":false,"m_textContent":"BEFEHL-STAND","disableLogging":false,"m_SIGUID":744110141001,"m_classType":"NotificationTrigger","m_comment":"Befehl aus der App Stempeln (stille Meldung BEFEHL-STAND)","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false}]},"macroExportVersion":1}